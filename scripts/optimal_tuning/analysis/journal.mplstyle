# Custom matplotlib style for Torque 2026

# Font settings
font.family: serif
font.serif: Latin Modern Roman
font.size: 10
text.usetex: False

# Figure size
figure.figsize: 6.84, 3.42

# Axes settings
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['000000', '27596f', '6abe98', 'edd79d'])
axes.grid: True

# Legend settings
legend.framealpha: 0.9
legend.loc: "upper right"

# PDF/PostScript settings (embedded fonts)
pdf.fonttype: 42
ps.fonttype: 42

# Save figure settings (minimize whitespace)
figure.constrained_layout.use: True
savefig.bbox: tight
savefig.pad_inches: 0.0

# Default colormap
image.cmap: viridis
